# Copy to keys.env (gitignored). One API key per variable (KEY=value, no trailing comments); systems.json names which
# variables a system uses (several = rotated in order). Fill in only what you use.

# gemini4_argon, gemini38_flash; also the judges (judge/config.json)
GEMINI_API_KEY=...
# gpt56_sol, gpt6_astra; also the stage-2 GPT judge
OPENAI_API_KEY=sk-...
# claude_opus, claude_sonnet
ANTHROPIC_API_KEY=sk-ant-...
# deepseek_dsh
DEEPSEEK_API_KEY=sk-...
# kimi_k3
MOONSHOT_API_KEY=sk-...
# glm53_flash
ZAI_API_KEY=...

# Always needed: the in-sandbox Qwen3-TTS tool (gateway/tts_gateway.py) and the qwen judge
DASHSCOPE_API_KEY=sk-...
# Only with an international (dashscope-intl) key: the TTS endpoint of that region
# DASHSCOPE_TTS_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
